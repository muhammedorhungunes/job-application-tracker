NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/job_tracker
JWT_ACCESS_SECRET=replace-with-32-plus-char-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-char-random-string
JWT_REFRESH_TTL=30d
WEB_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6380
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_MODEL=claude-opus-5-5
# Leave empty in development to log reminder emails instead of sending them.
RESEND_API_KEY=
EMAIL_FROM="Job Tracker <onboarding@resend.dev>"
REMINDER_HOUR=9
REMINDER_TZ=Europe/Istanbul
REMINDER_STALE_DAYS=7
INTERVIEW_REMINDER_CRON="0 * * * *"
INTERVIEW_REMINDER_LEAD_HOURS=24
