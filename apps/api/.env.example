NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/job_tracker
JWT_ACCESS_SECRET=replace-with-32-plus-char-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-char-random-string
JWT_REFRESH_TTL=30d
WEB_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6380
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_MODEL=claude-opus-5-5
