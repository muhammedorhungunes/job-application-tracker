generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
  WITHDRAWN
  // Day 6-7 Kanban work will likely add more granular states
  // (PHONE_SCREEN, TECHNICAL_INTERVIEW, ONSITE, ...). Prisma enums can't be
  // imported from external TS, so mirror any change here in
  // packages/types/src/application.ts by hand.
}

enum JobPostingParseStatus {
  PENDING
  COMPLETED
  FAILED
  // Mirrored by hand in packages/types/src/ai.ts, same as ApplicationStatus.
}

enum ActivityType {
  STATUS_CHANGE
  NOTE
  INTERVIEW_SCHEDULED
  APPLICATION_CREATED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  applications     Application[]
  refreshTokens    RefreshToken[]
  jobPostingParses JobPostingParse[]

  @@index([deletedAt])
}

// Auth infra, not one of the 4 "business" models from the roadmap — a single
// hashed-token field on User can't support rotation or multiple devices
// without races, so refresh tokens get their own table (see docs/roadmap.md
// open decisions / plan notes).
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // argon2 hash of the raw token; raw value never stored
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Company {
  id        String   @id @default(cuid())
  name      String
  website   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  applications Application[]

  @@index([deletedAt])
}

model Application {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  position  String
  status    ApplicationStatus @default(APPLIED)
  source    String?
  url       String?
  appliedAt DateTime?
  notes     String?
  techStack String[]          @default([])
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?

  activities Activity[]

  @@index([userId])
  @@index([companyId])
  @@index([deletedAt])
  @@index([status])
}

// Pure timeline log, no independent meaning without its Application — no
// deletedAt: a log entry is either part of the record or it's gone with it.
model Activity {
  id            String       @id @default(cuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          ActivityType
  description   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([applicationId])
}

// One "paste a posting, let Claude extract it" request. Processed by a BullMQ
// job; the web app polls it by id. Token counts are kept per row for cost
// tracking alongside the log line written on every call.
model JobPostingParse {
  id           String                @id @default(cuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawText      String
  status       JobPostingParseStatus @default(PENDING)
  result       Json?
  errorMessage String?
  model        String?
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?

  @@index([userId])
  @@index([deletedAt])
}
