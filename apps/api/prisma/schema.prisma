generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
  WITHDRAWN
  // Day 6-7 Kanban work will likely add more granular states
  // (PHONE_SCREEN, TECHNICAL_INTERVIEW, ONSITE, ...). Prisma enums can't be
  // imported from external TS, so mirror any change here in
  // packages/types/src/application.ts by hand.
}

enum JobPostingParseStatus {
  PENDING
  COMPLETED
  FAILED
  // Mirrored by hand in packages/types/src/ai.ts, same as ApplicationStatus.
}

enum ActivityType {
  STATUS_CHANGE
  NOTE
  INTERVIEW_SCHEDULED
  APPLICATION_CREATED
  INTERVIEW_CANCELLED
  // Mirrored by hand in packages/types/src/activity.ts.
}

enum InterviewKind {
  PHONE
  TECHNICAL
  ONSITE
  OTHER
  // Mirrored by hand in packages/types/src/interview.ts.
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  // Reminder settings. A null override means "use the env default"
  // (REMINDER_TZ / REMINDER_STALE_DAYS), so changing the env still moves
  // every user who never picked a value.
  timeZone                  String?
  staleDigestEnabled        Boolean  @default(true)
  staleDays                 Int?
  interviewRemindersEnabled Boolean  @default(true)

  applications     Application[]
  refreshTokens    RefreshToken[]
  jobPostingParses JobPostingParse[]

  @@index([deletedAt])
}

// Auth infra, not one of the 4 "business" models from the roadmap — a single
// hashed-token field on User can't support rotation or multiple devices
// without races, so refresh tokens get their own table (see docs/roadmap.md
// open decisions / plan notes).
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // argon2 hash of the raw token; raw value never stored
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Company {
  id        String   @id @default(cuid())
  name      String
  website   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  applications Application[]

  @@index([deletedAt])
}

model Application {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  position  String
  status    ApplicationStatus @default(APPLIED)
  source    String?
  url       String?
  appliedAt DateTime?
  notes     String?
  techStack String[]          @default([])
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?

  activities Activity[]
  reminders  ApplicationReminder[]
  interviews Interview[]

  @@index([userId])
  @@index([companyId])
  @@index([deletedAt])
  @@index([status])
}

// Timeline of an application. System entries (creation, status changes,
// interview events) are a log and are never deleted; only user-written NOTE
// entries can be, which is what deletedAt is for.
model Activity {
  id            String       @id @default(cuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          ActivityType
  description   String
  // Structured so stats can query them; `description` is display text only.
  // STATUS_CHANGE sets both, APPLICATION_CREATED sets toStatus, other types
  // neither. Creation rows backfilled for pre-history applications have
  // toStatus null since their initial status isn't known.
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  @@index([applicationId])
  @@index([deletedAt])
}

// An entity rather than an Activity entry: it can be rescheduled or
// cancelled. Each of those also writes an Activity row for the timeline.
model Interview {
  id            String        @id @default(cuid())
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          InterviewKind
  scheduledAt   DateTime
  notes         String?
  // The scheduledAt the last reminder e-mail was about. A reschedule makes
  // it differ from scheduledAt, so the interview is reminded again.
  remindedForScheduledAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  @@index([applicationId])
  @@index([deletedAt])
  @@index([scheduledAt])
}

// One row per application included in a sent reminder digest. Kept apart
// from Application because writing to it would bump Application.updatedAt
// (@updatedAt), which is exactly the "last touched" signal reminders key off.
// A pure send log like Activity, so no deletedAt.
model ApplicationReminder {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sentAt        DateTime    @default(now())

  @@index([applicationId, sentAt])
}

// One "paste a posting, let Claude extract it" request. Processed by a BullMQ
// job; the web app polls it by id. Token counts are kept per row for cost
// tracking alongside the log line written on every call.
model JobPostingParse {
  id           String                @id @default(cuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawText      String
  status       JobPostingParseStatus @default(PENDING)
  result       Json?
  errorMessage String?
  model        String?
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?

  @@index([userId])
  @@index([deletedAt])
}
